# =============================================================================
# ProGuideGH — environment variable template (Spec §25)
# Copy to .env and fill in real values. NEVER commit a real .env.
# =============================================================================

# Application environment: local | staging | production
APP_ENV=local

# PostgreSQL (system of record)
DATABASE_URL=postgres://proguidegh:proguidegh@localhost:5432/proguidegh?sslmode=disable

# Redis (ephemeral: presence, locks, idempotency cache, rate limits, offer TTLs)
REDIS_URL=redis://localhost:6379

# Session/token secret — generate a long random value per environment
JWT_OR_SESSION_SECRET=change-me-in-every-environment

# HTTP ports
API_PORT=8080
WORKER_PORT=8081

# Object storage adapter: local (dev, writes to STORAGE_LOCAL_DIR) | r2 (Cloudflare R2, signed URLs)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./data/uploads

# Cloudflare R2 (private object storage, signed URLs only)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PRIVATE=

# Resend (transactional email)
RESEND_API_KEY=

# Payments — adapter-selected provider (paystack | mock; mock used when no secret set)
PAYMENT_PROVIDER=paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
# Dev-only: HMAC secret for the mock payment provider's signed webhooks
MOCK_WEBHOOK_SECRET=dev-mock-webhook-secret

# Payout account refs: AES-256-GCM key for encrypting destination refs at
# rest (Phase 7). Falls back to JWT_OR_SESSION_SECRET when unset — set it
# per environment like any secret.
PAYOUT_ACCOUNT_KEY=

# CORS: comma-separated web-app origins allowed to make credentialed
# cross-origin calls (P9-01). Defaults to the local Next.js dev ports.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Google Maps
GOOGLE_MAPS_API_KEY_SERVER=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=   # browser-restricted key only

# Firebase Cloud Messaging (push)
FCM_PROJECT_ID=

# Observability
SENTRY_DSN=

# SMS provider (OTP / critical fallback)
SMS_PROVIDER=
SMS_API_KEY=
